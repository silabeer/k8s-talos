cluster_name = "talos"
zone         = "ru-central1-a"

# Текущий адрес машины, с которой запускается tofu, добавляется автоматически
# (auto_admin_ip = true). Здесь перечисляют постоянные адреса, например офисные.
admin_cidrs = []

# Ограничьте при желании; kube-apiserver защищён mTLS.
apiserver_allowed_cidrs = ["0.0.0.0/0"]

controlplane = {
  count   = 3
  cores   = 2
  memory  = 4
  disk_gb = 20
}

worker = {
  count        = 2
  cores        = 2
  memory       = 4
  disk_gb      = 40
  data_disk_gb = 50 # отдельный диск под LINSTOR (/dev/vdb); 0 = без диска
  # data_disk_type = "network-ssd"  # быстрее, но тратит квоту compute.ssdDisks.size
}

# Расширения Talos. drbd нужен для LINSTOR (kubernetes/infrastructure/piraeus).
# Installer с ними собирается локально (docker + crane) и публикуется в Artifact Keeper.
talos_extensions = ["siderolabs/drbd"]

# Для экономии на тестовом стенде можно 20 или 50.
core_fraction = 100

# Статический публичный IP на каждый узел. Квота vpc.externalStaticAddresses.count
# по умолчанию 2 и уходит на балансировщики; включайте после запроса квоты.
node_static_ips = false

# Artifact Keeper: прокси образов и чартов на отдельной ВМ (см. README).
registry = {
  enabled     = true
  version     = "1.8.2"
  web_version = "latest"
  cores       = 2
  memory      = 4
  disk_gb     = 30
}
# registry_ssh_public_key = "ssh-ed25519 AAAA... you@host"
